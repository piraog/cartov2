    {
      "key": "temps_voiture_gare_plus_proche_min",
      "name": "Temps voiture vers gare la plus proche",
      "category": "accessibilite",
      "unit": "minutes",
      "source": "sncf_osm",
      "geography_level": "commune"
    },
    {
      "key": "temps_voiture_ville_30000_min",
      "name": "Temps voiture vers ville de plus de 30 000 habitants",

      "source": "climat",
      "geography_level": "commune"
    }
  ],
  "criteria": [
    {
      "key": "budget_immobilier",
      "name": "Budget immobilier",
      "category": "Budget",
      "description": "Favorise les communes ou le prix median au m2 est plus accessible.",
      "default_weight": 1,
      "rule": {
        "type": "lower_is_better",
        "indicator": "prix_m2_median",
        "min_value": 1200,
        "max_value": 6500,
        "clamp": true
      }
    },
    {
      "key": "accessibilite_paris",
      "name": "Isochrone train Paris",
      "category": "Accessibilite",
      "description": "Score le temps total depuis Paris en train puis voiture.",
      "default_weight": 1,
      "rule": {
        "type": "lower_is_better",
        "indicator": "temps_total_paris_train_voiture_min",
        "min_value": 60,
        "max_value": 360,
        "clamp": true
      },
      "exclusion": {
        "max_value": 420
      }
    },
    {
      "key": "acces_gare",
      "name": "Acces a une gare",
      "category": "Accessibilite",
      "description": "Favorise les communes proches d'une gare en voiture.",
      "default_weight": 0.8,
      "rule": {
        "type": "steps",
        "indicator": "temps_voiture_gare_plus_proche_min",
        "steps": [
          { "max": 10, "score": 100 },
          { "max": 20, "score": 80 },
          { "max": 35, "score": 55 },
          { "max": 60, "score": 25 },
          { "score": 0 }
        ]
      }
    },
    {
      "key": "proximite_ville_moyenne",
      "name": "Ville de plus de 30 000 habitants",
      "category": "Accessibilite",
      "description": "Cherche un equilibre entre calme et acces a une ville de services.",
      "default_weight": 0.7,
      "rule": {
        "type": "ideal_range",
        "indicator": "temps_voiture_ville_30000_min",
        "min_ideal": 15,
        "max_ideal": 45,
        "min_acceptable": 0,
        "max_acceptable": 90
      }
    },
    {
      "key": "densite_equilibree",
      "name": "Densite equilibree",
      "category": "Cadre de vie",
      "description": "Evite les zones trop isolees et les zones trop denses.",
      "default_weight": 0.5,
      "rule": {
        "type": "ideal_range",
        "indicator": "densite_population",
        "min_ideal": 30,
        "max_ideal": 180,
        "min_acceptable": 5,
        "max_acceptable": 1200
      }
    },
    {
      "key": "residences_secondaires",
      "name": "Presence de residences secondaires",
      "category": "Cadre de vie",
      "description": "Repere les communes deja attractives pour les residences secondaires.",
      "default_weight": 0.4,
      "rule": {
        "type": "higher_is_better",
        "indicator": "part_residences_secondaires",
        "min_value": 2,
        "max_value": 45,
        "clamp": true
      }
    },
    {
      "key": "nature",
      "name": "Proximite nature",
      "category": "Nature",
      "description": "Favorise la proximite mer, montagne ou foret.",
      "default_weight": 0.8,
      "rule": {
        "type": "higher_is_better",
        "indicator": "proximite_nature_score",
        "min_value": 0,
        "max_value": 100,
        "clamp": true
      }
    },
    {
      "key": "risque_inondation",
      "name": "Risque inondation",
      "category": "Risques",
      "description": "Penalise les communes exposees a un risque d'inondation eleve.",
      "default_weight": 0.9,
      "rule": {
        "type": "categorical",
        "indicator": "risque_inondation_niveau",
        "mapping": {
          "aucun": 100,
          "faible": 85,
          "moyen": 45,
          "fort": 5
        },
        "exclude_if": ["fort"]
      }
    },
    {
      "key": "services",
      "name": "Services et equipements",
      "category": "Services",
      "description": "Favorise les territoires equipes en services de proximite.",
      "default_weight": 0.7,
      "rule": {
        "type": "higher_is_better",
        "indicator": "equipements_services_30km",
        "min_value": 20,
        "max_value": 250,
        "clamp": true
      }
    },
    {
      "key": "rayonnement_culturel",
      "name": "Rayonnement culturel",
      "category": "Culture",
      "description": "Combine festivals, lieux culturels et patrimoine dans un rayon de 30 km.",
      "default_weight": 0.7,
      "rule": {
        "type": "weighted_composite",
        "components": [
          {
            "indicator": "festivals_30km",
            "weight": 0.35,
            "rule": { "type": "higher_is_better", "min_value": 0, "max_value": 8, "clamp": true }
          },
          {
            "indicator": "lieux_culturels_30km",
            "weight": 0.35,
            "rule": { "type": "higher_is_better", "min_value": 0, "max_value": 60, "clamp": true }
          },
          {
            "indicator": "monuments_historiques_30km",
            "weight": 0.30,
            "rule": { "type": "higher_is_better", "min_value": 0, "max_value": 80, "clamp": true }
          }
        ]
      }
    },
    {
      "key": "potentiel_viticole",
      "name": "Potentiel agricole et viticole",
      "category": "Agriculture",
      "description": "Proxy combinant AOC, surfaces de vignes, surface agricole, altitude, pente et climat.",
      "default_weight": 0.6,
      "rule": {
        "type": "weighted_composite",
        "components": [
          {
            "indicator": "presence_zone_aoc_viticole",
            "weight": 0.25,
            "rule": { "type": "categorical", "mapping": { "true": 100, "false": 0 } }
          },
          {
            "indicator": "surface_vigne_pct",
            "weight": 0.20,
            "rule": { "type": "higher_is_better", "min_value": 0, "max_value": 25, "clamp": true }
          },
          {
            "indicator": "surface_agricole_pct",
            "weight": 0.15,
            "rule": { "type": "higher_is_better", "min_value": 5, "max_value": 80, "clamp": true }
          },
          {
            "indicator": "altitude_moyenne",
            "weight": 0.10,
            "rule": { "type": "ideal_range", "min_ideal": 80, "max_ideal": 450, "min_acceptable": 0, "max_acceptable": 900 }
          },
          {
            "indicator": "pente_moyenne",
            "weight": 0.10,
            "rule": { "type": "ideal_range", "min_ideal": 3, "max_ideal": 18, "min_acceptable": 0, "max_acceptable": 35 }
          },
          {
            "indicator": "temperature_moyenne_annuelle",
            "weight": 0.20,
            "rule": { "type": "ideal_range", "min_ideal": 11, "max_ideal": 16, "min_acceptable": 8, "max_acceptable": 21 }
          }
        ]
      }
    },
    {
      "key": "climat_confortable",
      "name": "Climat confortable",
      "category": "Climat",
      "description": "Favorise un climat tempere, lumineux et limite en jours de gel.",
      "default_weight": 0.7,
      "rule": {
        "type": "weighted_composite",
        "components": [
          {
            "indicator": "temperature_moyenne_annuelle",
            "weight": 0.45,
            "rule": { "type": "ideal_range", "min_ideal": 12, "max_ideal": 17, "min_acceptable": 7, "max_acceptable": 22 }
          },
          {
            "indicator": "ensoleillement_annuel_heures",
            "weight": 0.35,
            "rule": { "type": "higher_is_better", "min_value": 1500, "max_value": 2800, "clamp": true }
          },
          {
            "indicator": "jours_gel_annuels",
            "weight": 0.20,
            "rule": { "type": "lower_is_better", "min_value": 5, "max_value": 90, "clamp": true }
          }
        ]
      }
    }
  ],
